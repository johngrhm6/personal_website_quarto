social_caption <- function(
linkedin = "johnmichaelgraham",
github = "johngrhm6",
bluesky = "johngrhm",
icon_color = "black",
font_color = "black",
font_family = "sans"
) {
icons_df <- data.frame(
icons = c("&#xf08c;", "&#xe671;", "&#xf09b;"),
socials = c(linkedin, bluesky, github)
) |>
tidyr::drop_na() |>
dplyr::filter(socials != "")
caption <- purrr::map2_chr(
icons_df$icons,
icons_df$socials,
\(icon, social) {
glue::glue(
"<span style='font-family:\"Font Awesome 7\"; color:{icon_color};'>{icon}</span>&nbsp;
<span style='font-family:{font_family}; color:{font_color};'>{social}</span>&emsp;"
)
}
) |>
stringr::str_flatten()
caption
}
